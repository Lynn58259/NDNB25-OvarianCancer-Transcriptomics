renv/
.cache/

# Python environments and caches
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# Raw sequencing files are outside this processed-matrix release.
*.fastq
*.fastq.gz
*.bam
*.bai

